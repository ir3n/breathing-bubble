{
  "name": "@ir3n/react-breathing-bubble",
  "version": "1.0.0",
  "description": "Animated breathing bubble/orb React component for guided breathing exercises with customizable inhale/hold/exhale timing, for meditation and mindfulness apps.",
  "keywords": [
    "react",
    "react-component",
    "breathing",
    "breathing-exercise",
    "breathing-bubble",
    "breathing-orb",
    "bubble",
    "meditation",
    "mindfulness",
    "wellness",
    "relaxation",
    "animation",
    "box-breathing",
    "guided-breathing",
    "anxiety",
    "typescript"
  ],
  "homepage": "https://github.com/ir3n/breathing-bubble#readme",
  "bugs": {
    "url": "https://github.com/ir3n/breathing-bubble/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ir3n/breathing-bubble.git"
  },
  "license": "MIT",
  "author": "ir3n",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.0"
  }
}
